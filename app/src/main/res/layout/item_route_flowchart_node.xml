<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="8dp"
    android:background="?attr/selectableItemBackground">

    <!-- Timeline Indicator Column -->
    <LinearLayout
        android:layout_width="36dp"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvNodeNumber"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/tab_chip_background"
            android:backgroundTint="#1A365D"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="1" />

        <View
            android:id="@+id/viewTimelineLine"
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:minHeight="40dp"
            android:layout_marginTop="4dp"
            android:background="#CBD5E1" />
    </LinearLayout>

    <!-- Node Content Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardNode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="8dp"
        app:cardBackgroundColor="#F8FAFC"
        app:cardCornerRadius="12dp"
        app:cardElevation="1dp"
        app:strokeColor="#E2E8F0"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="10dp"
            android:gravity="center_vertical">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivNodePhoto"
                android:layout_width="72dp"
                android:layout_height="54dp"
                android:scaleType="centerInside"
                android:padding="8dp"
                android:background="#F1F5F9"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium"
                tools:src="@drawable/ic_building_academic" />

            <!-- Text Information -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvNodeTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="#0F172A"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        tools:text="Academic Block Entrance" />

                    <TextView
                        android:id="@+id/tvNodeDirectionIcon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"
                        tools:text="⬆️" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvNodeInstruction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:textColor="#475569"
                    android:textSize="12sp"
                    tools:text="Proceed through main doors into the reception hall." />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvNodeFloorBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/tab_chip_background"
                        android:backgroundTint="#E2E8F0"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp"
                        android:textColor="#334155"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        tools:text="Floor 0" />

                    <TextView
                        android:id="@+id/tvNodeDistance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:textColor="#64748B"
                        android:textSize="11sp"
                        tools:text="• 50m" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
