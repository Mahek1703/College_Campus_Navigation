<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top App Bar -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbarVisualNav"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="#1E293B"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="#FFFFFF"
            app:title="Campus Visual Navigator"
            app:titleTextColor="#FFFFFF"
            app:titleTextAppearance="@style/TextAppearance.Material3.TitleMedium">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:gravity="center_vertical"
                android:paddingEnd="12dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnToolbarFlowchart"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Flowchart"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    app:backgroundTint="#334155"
                    app:icon="@drawable/ic_route"
                    app:iconSize="16dp"
                    app:iconTint="#60A5FA" />

            </LinearLayout>

        </com.google.android.material.appbar.MaterialToolbar>

        <!-- Route Selector & Quick Chips Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1E293B"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="12dp">

            <!-- Start & Destination Pickers -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <!-- Start Spinner -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:background="@drawable/tab_chip_background"
                        android:backgroundTint="#334155"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🟢 From:"
                            android:textColor="#94A3B8"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <Spinner
                            android:id="@+id/spinnerStartLocation"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:popupBackground="#1E293B"
                            android:theme="@style/ThemeOverlay.AppCompat.Dark" />
                    </LinearLayout>

                    <!-- Destination Spinner -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/tab_chip_background"
                        android:backgroundTint="#334155"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🔴 To:"
                            android:textColor="#94A3B8"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <Spinner
                            android:id="@+id/spinnerDestLocation"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:popupBackground="#1E293B"
                            android:theme="@style/ThemeOverlay.AppCompat.Dark" />
                    </LinearLayout>

                </LinearLayout>

                <!-- Swap Route Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSwapRoute"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    app:backgroundTint="#334155"
                    app:icon="@drawable/ic_compass"
                    app:iconTint="#38BDF8" />

            </LinearLayout>

            <!-- Quick Preset Chips -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupQuickRoutes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleLine="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipCyberLab"
                        style="@style/Widget.Material3.Chip.Assist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Gate ➔ Cyber Lab 204"
                        android:textColor="#FFFFFF"
                        app:chipBackgroundColor="#0284C7"
                        app:chipStrokeColor="#38BDF8"
                        app:chipStrokeWidth="1dp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipSmartClass"
                        style="@style/Widget.Material3.Chip.Assist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Gate ➔ Smart Class 201"
                        android:textColor="#E2E8F0"
                        app:chipBackgroundColor="#334155"
                        app:chipStrokeColor="#475569" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipAuditorium"
                        style="@style/Widget.Material3.Chip.Assist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Gate ➔ Auditorium"
                        android:textColor="#E2E8F0"
                        app:chipBackgroundColor="#334155"
                        app:chipStrokeColor="#475569" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipLibrary"
                        style="@style/Widget.Material3.Chip.Assist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Gate ➔ Library"
                        android:textColor="#E2E8F0"
                        app:chipBackgroundColor="#334155"
                        app:chipStrokeColor="#475569" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipCanteen"
                        style="@style/Widget.Material3.Chip.Assist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Gate ➔ Canteen"
                        android:textColor="#E2E8F0"
                        app:chipBackgroundColor="#334155"
                        app:chipStrokeColor="#475569" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipNetLab"
                        style="@style/Widget.Material3.Chip.Assist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Reception ➔ Net Lab"
                        android:textColor="#E2E8F0"
                        app:chipBackgroundColor="#334155"
                        app:chipStrokeColor="#475569" />

                </com.google.android.material.chip.ChipGroup>

            </HorizontalScrollView>

        </LinearLayout>

        <!-- Step Progress Bar -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/stepProgressBar"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:max="100"
            android:progress="15"
            app:indicatorColor="#38BDF8"
            app:trackColor="#1E293B" />

        <!-- Scrollable Middle Body -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Visual Viewport Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardVisualViewport"
                    android:layout_width="match_parent"
                    android:layout_height="250dp"
                    app:cardBackgroundColor="#000000"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    app:strokeColor="#334155"
                    app:strokeWidth="1dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <ImageView
                            android:id="@+id/ivCurrentStepPhoto"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerInside"
                            android:padding="32dp"
                            android:background="#0F172A"
                            tools:src="@drawable/ic_building_academic" />

                        <!-- Dark Scrim Gradient -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/scrim_gradient" />

                        <!-- Top Floating Direction Banner -->
                        <LinearLayout
                            android:id="@+id/bannerDirectionOverlay"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="top|start"
                            android:layout_margin="12dp"
                            android:background="@drawable/tab_chip_background"
                            android:backgroundTint="#CC0F172A"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp">

                            <TextView
                                android:id="@+id/tvDirectionIcon"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="18sp"
                                tools:text="⬆️" />

                            <TextView
                                android:id="@+id/tvDirectionText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:textColor="#FFFFFF"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                tools:text="Proceed Straight Ahead" />
                        </LinearLayout>

                        <!-- Top Right Floor Badge -->
                        <TextView
                            android:id="@+id/tvStepFloorBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="top|end"
                            android:layout_margin="12dp"
                            android:background="@drawable/tab_chip_background"
                            android:backgroundTint="#0284C7"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="Grounds" />

                        <!-- Bottom Step Counter & Distance Badge -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom"
                            android:gravity="center_vertical"
                            android:padding="12dp"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvStepCounterBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/tab_chip_background"
                                android:backgroundTint="#CC1E293B"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="4dp"
                                android:textColor="#38BDF8"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                tools:text="Step 1 of 7" />

                            <TextView
                                android:id="@+id/tvStepDistanceBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:background="@drawable/tab_chip_background"
                                android:backgroundTint="#CC1E293B"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="4dp"
                                android:textColor="#F1F5F9"
                                android:textSize="12sp"
                                tools:text="• 50 meters" />

                        </LinearLayout>

                    </FrameLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Detailed Step Instruction Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:cardBackgroundColor="#1E293B"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:strokeColor="#334155"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvStepTitle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textColor="#FFFFFF"
                                android:textSize="17sp"
                                android:textStyle="bold"
                                tools:text="Main Entrance &amp; Security Gate" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnSpeakStep"
                                style="@style/Widget.Material3.Button.IconButton"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                app:icon="@drawable/ic_notification"
                                app:iconTint="#38BDF8" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvStepInstruction"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:lineSpacingExtra="3dp"
                            android:textColor="#CBD5E1"
                            android:textSize="14sp"
                            tools:text="Proceed straight past the security kiosk under the 'Tech Campus' archway along the central avenue towards the Academic Building." />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="10dp"
                            android:background="#334155" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvStepLandmark"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textColor="#94A3B8"
                                android:textSize="12sp"
                                tools:text="📍 Landmark: Tech Campus Archway • Security Kiosk" />

                            <TextView
                                android:id="@+id/tvRouteTotalEst"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="#38BDF8"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                tools:text="Total: 210m • 3 mins" />
                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </ScrollView>

        <!-- Bottom Controller Bar -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#1E293B"
            app:cardCornerRadius="0dp"
            app:cardElevation="8dp"
            app:strokeColor="#334155"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"
                android:orientation="horizontal">

                <!-- Previous Step Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPrevStep"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="Previous"
                    android:textColor="#E2E8F0"
                    android:textSize="13sp"
                    app:icon="@drawable/ic_arrow_back"
                    app:iconTint="#CBD5E1"
                    app:strokeColor="#475569" />

                <!-- Auto Play Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAutoPlay"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginHorizontal="8dp"
                    android:text="Auto"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    app:backgroundTint="#0369A1"
                    app:icon="@drawable/ic_time"
                    app:iconTint="#FFFFFF" />

                <!-- Next Step Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNextStep"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="Next Step"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    app:backgroundTint="#0284C7"
                    app:icon="@drawable/ic_chevron_right"
                    app:iconGravity="textEnd"
                    app:iconTint="#FFFFFF" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
